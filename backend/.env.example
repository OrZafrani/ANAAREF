PORT=4000

# Cobra generation API (backend only). Keep the Kubernetes port-forward running.
COBRA_API=http://127.0.0.1:8080
COBRA_API_TOKEN=
# Redis holds the AI generation rate limit. For local development: `docker compose up -d` at the repo root.
# While Redis is down, AI generation is refused (503); the rest of the API works.
REDIS_URL=redis://localhost:6379
# AI generations each client (IP) may start per window, shared by all backend instances.
AI_GENERATION_RATE_LIMIT=2
AI_GENERATION_RATE_WINDOW_S=60
# Set when the backend runs behind a reverse proxy, so client IPs come from X-Forwarded-For:
# a hop count (1), true, or the proxy addresses. Unset, every client shares the proxy's IP.
# TRUST_PROXY=1

# PostgreSQL. Schema and migrations: backend/migrations

DATABASE_URL=
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000
NODE_TLS_REJECT_UNAUTHORIZED=0

# Kafka. For local development: `docker compose up -d` at the repo root.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=cobra-simulation-engine
KAFKA_TOPIC_ENRICHED_REPORTS=reports.enriched
KAFKA_PRODUCER_RETRIES=5
# How long one send keeps retrying before the run is marked failed.
KAFKA_DELIVERY_TIMEOUT_MS=60000
# Secured broker (e.g. the cluster's SCRAM-SHA-512 listener on :9093). Leave commented for local docker compose.
# KAFKA_SASL_USERNAME=kafka-client
# KAFKA_SASL_PASSWORD=
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SSL_CA_LOCATION=/etc/kafka-ca/ca.crt   # absolute path; setting it turns TLS on
# KAFKA_SSL=true                               # TLS with the system trust store

# Scheduler
SCHEDULER_BATCH_SIZE=100
# A started run is marked failed this long after its length (or last dispatch offset).
RUN_TIMEOUT_GRACE_S=300
SCHEDULER_WATCHDOG_INTERVAL_S=30
