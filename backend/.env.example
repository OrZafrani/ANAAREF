PORT=4000
# Interface the API listens on. 127.0.0.1 keeps it on this machine; the API has no sign-in yet,
# so only use 0.0.0.0 behind a firewall or reverse proxy.
HOST=127.0.0.1
# Browser origins allowed to call the API directly, comma-separated. Leave empty when the frontend
# goes through the Vite proxy (development) or a reverse proxy on the same origin.
CORS_ORIGINS=
# Requests that change data (POST/PATCH/DELETE), per client IP per minute.
RATE_LIMIT_WRITES_PER_MIN=120

# PostgreSQL. Schema and migrations: backend/migrations

DATABASE_URL=
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000
# Database with a private or self-signed certificate: path to its CA certificate (PEM).
# The connection is then verified. Do not use NODE_TLS_REJECT_UNAUTHORIZED=0, which turns off
# certificate checks for every outgoing TLS connection, not just the database.
DATABASE_SSL_CA=

# Kafka. For local development: `docker compose up -d` at the repo root.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=cobra-simulation-engine
KAFKA_TOPIC_ENRICHED_REPORTS=reports.enriched
KAFKA_PRODUCER_RETRIES=5
# How long one send keeps retrying before the run is marked failed.
KAFKA_DELIVERY_TIMEOUT_MS=60000

# Scheduler
SCHEDULER_BATCH_SIZE=100
# A started run is marked failed this long after its length (or last dispatch offset).
RUN_TIMEOUT_GRACE_S=300
SCHEDULER_WATCHDOG_INTERVAL_S=30
